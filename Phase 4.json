      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const items = $('Select and Combine').all();\nconst today = $now.toFormat('yyyy-MM-dd');\n\nreturn $input.all().map((item, i) => {\n  const out = item.json.output;\n  const idea = items[i].json;\n  const script = out.script || '';\n  return {\n    json: {\n      'Video ID': idea['Video ID'],\n      'Title': idea['Title'],\n      'Hook': out.hook,\n      'Script': script,\n      'Call To Action': out.call_to_action,\n      'Word Count': script.trim().split(/\\s+/).length,\n      'Status': 'Script Ready',\n      'Date Created': today\n    }\n  };\n});"
      },
