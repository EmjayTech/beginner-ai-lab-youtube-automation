    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"hook\": \"Ever asked an AI a question and got a useless answer? Stay with me, because in the next five minutes you will fix that.\",\n  \"script\": \"HOOK\\n...\\n\\nSECTION 1: ...\\n...\\n\\nCONCLUSION\\n...\\n\\nCALL TO ACTION\\n...\",\n  \"call_to_action\": \"If this helped, subscribe and watch our next video on writing better prompts.\"\n}"
      },
