    {
      "parameters": {
        "jsCode": "// Videos that have a script but no Publishing Data row yet\nconst done = new Set($('Read Existing Publishing Data').all().map(i => i.json['Video ID']).filter(Boolean));\nconst seen = new Set();\nconst out = [];\nfor (const item of $('Read Scripts').all()) {\n  const id = item.json['Video ID'];\n  if (!id || !item.json['Script'] || done.has(id) || seen.has(id)) continue;\n  seen.add(id);\n  out.push({ json: item.json });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2496,
        1152
      ],
      "id": "ab15b825-1fdd-4654-85ed-f17d81500f12",
      "name": "Select Videos For Publishing Data"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $input.item.json };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2944,
        1024
      ],
      "id": "26e86937-dbb9-4a14-84af-6566f493fabd",
      "name": "Prepare Publishing Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a YouTube publishing specialist for a fictional beginner-focused channel called \"Beginner AI Lab\".\nTone: clear, friendly and honest. Audience: students and beginners.\n\nCreate the publishing information for this video, based ONLY on the script below.\n\nWorking title: {{ $json['Title'] }}\n\nSCRIPT:\n{{ $json['Script'] }}\n\nProvide:\n- title_options: exactly 5 different YouTube titles. Each must be clear, relevant to what the video really covers, and under 70 characters.\n- recommended_title: the best one of the five (copy it exactly)\n- title_reason: one sentence explaining why it fits the video's actual content\n- description: a YouTube description of 80 to 150 words. First 2 sentences should summarize the video and make viewers want to watch. Include a natural call to action to subscribe. No links.\n- tags: 10 to 15 relevant keywords or short phrases\n- summary: a 2 to 3 sentence summary of the video\n- chapters: one short chapter title for EACH script section, in the same order as the script (HOOK, each SECTION, CONCLUSION, CALL TO ACTION). Use 2 to 5 words each.\n\nRules:\n- Use only what is in the script. Do not invent statistics, prices, results or product features.\n- No clickbait or exaggerated promises (avoid words like \"ultimate\", \"guaranteed\", \"secret\", \"shocking\" unless the script supports them).\n- Do not use real logos, real channel names or copyrighted content.\n- Keep any [VERIFY] items out of the title and description. Do not state them as facts.\n\nReturn only the structured data.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        3168,
        1024
      ],
      "id": "56b752b3-72b3-478b-bea2-a2e67290a496",
      "name": "Generate Publishing Data",
      "retryOnFail": false
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Prepare Publishing Input').item.json;\nconst out = $json.output;\nconst WPM = 150;\n\nconst fmt = (secs) => {\n  const m = Math.floor(secs / 60);\n  const s = Math.round(secs % 60);\n  return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;\n};\nconst sectionWords = (script) => {\n  const header = /^(HOOK|SECTION\\s*\\d+.*|CONCLUSION|CALL TO ACTION)\\s*$/i;\n  const sections = [];\n  for (const line of String(script).split('\\n')) {\n    if (header.test(line.trim())) { sections.push(0); continue; }\n    if (sections.length) sections[sections.length - 1] += line.trim().split(/\\s+/).filter(Boolean).length;\n  }\n  return sections;\n};\n\nconst chapters = out.chapters || [];\nlet words = sectionWords(src['Script']);\nif (words.length !== chapters.length) {\n  const total = String(src['Script']).trim().split(/\\s+/).length;\n  words = chapters.map(() => total / Math.max(chapters.length, 1));\n}\nlet secs = 0;\nconst chapterLines = chapters.map((title, idx) => {\n  const line = `${fmt(secs)} ${title}`;\n  secs += (words[idx] / WPM) * 60;\n  return line;\n});\n\nreturn { json: {\n  'Video ID': src['Video ID'],\n  'Original Title': src['Title'],\n  'Title Options': (out.title_options || []).map((t, n) => `${n + 1}. ${t}`).join('\\n'),\n  'Recommended Title': out.recommended_title,\n  'Title Reason': out.title_reason,\n  'Description': out.description,\n  'Tags': (out.tags || []).join(', '),\n  'Summary': out.summary,\n  'Chapters': chapterLines.join('\\n') + '\\n(estimated timestamps)',\n  'Status': 'Publishing Data Ready',\n  'Date Created': $now.toFormat('yyyy-MM-dd')\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
