      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const research = $input.item.json;\nconst ideas = $('Read Video Ideas').all().map(i => i.json);\nconst idea = ideas.find(i => i['Video ID'] === research['Video ID']) || {};\nreturn { json: {\n  'Video ID': research['Video ID'],\n  'Title': research['Title'] || idea['Title'],\n  'Category': idea['Category'] || 'Tutorial',\n  'Target Audience': idea['Target Audience'] || 'Absolute beginners',\n  research\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        736
      ],
      "id": "d7629503-6b0f-47d5-a6da-6156b37f80ae",
      "name": "Prepare Script Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a scriptwriter for a fictional beginner-focused YouTube channel called \"Beginner AI Lab\".\nTone: friendly, simple, practical and jargon-free. Write for students and beginners with no technical background.\n\nWrite a complete YouTube script for this video.\n\nTitle: {{ $json['Title'] }}\nCategory: {{ $json['Category'] }}\nTarget audience: {{ $json['Target Audience'] }}\n\nRESEARCH PLAN (use only this material):\nLearning goal: {{ $json.research['Learning Goal'] }}\nMain points: {{ $json.research['Main Points'] }}\nViewer questions: {{ $json.research['Viewer Questions'] }}\nIntro idea: {{ $json.research['Intro'] }}\nMain content plan: {{ $json.research['Main Content'] }}\nExamples: {{ $json.research['Examples'] }}\nConclusion idea: {{ $json.research['Conclusion'] }}\nItems to verify: {{ $json.research['To Verify'] }}\n\nWrite:\n- hook: an interesting opening (2 to 4 sentences) that explains why viewers should keep watching\n- script: the full spoken script, in this order:\n  1. HOOK\n  2. MAIN CONTENT, divided into clearly labelled sections (SECTION 1, SECTION 2 ...) covering the main points, with a simple example where useful\n  3. CONCLUSION: short recap\n  4. CALL TO ACTION\n- call_to_action: one natural sentence asking viewers to subscribe or watch another video\n\nRules:\n- Use short, simple sentences that are easy to say out loud.\n- Use ONLY information from the research plan. Do not invent statistics, prices, product features or claims.\n- For anything listed under \"Items to verify\", do not state it as fact. Write [VERIFY: short note] instead.\n- Do not use real logos, real channel names or copyrighted content.\n- Aim for about 400 to 600 words.\n\nReturn only the structured data.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1232,
        736
      ],
      "id": "4594d1cb-c6fa-4b64-95ea-a0e2456f2987",
      "name": "Generate Script",
      "retryOnFail": false
    },
