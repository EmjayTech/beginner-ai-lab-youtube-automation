    {
      "parameters": {
        "jsCode": "// Skips any video that already has a row in the Scripts sheet,\n// plus anything listed in `skip`. Also removes duplicate Video IDs.\nconst skip = [];\nconst scripted = new Set($('Read Existing Scripts').all().map(i => i.json['Video ID']).filter(Boolean));\nconst seen = new Set();\nconst out = [];\nfor (const item of $('Read Content Research').all()) {\n  const id = item.json['Video ID'];\n  if (!id || skip.includes(id) || scripted.has(id) || seen.has(id)) continue;\n  seen.add(id);\n  out.push({ json: item.json });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        928
      ],
      "id": "117b006a-d0b4-45d3-9711-c515dc29896f",
      "name": "Select Videos To Script"
    },
