    {
      "parameters": {
        "jsCode": "const ids = $('Set Selected Videos').first().json.selected_ids\n  .split(',')\n  .map(s => s.trim())\n  .filter(Boolean);\n\nreturn $input.all().filter(item => ids.includes(item.json['Video ID']));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "48a745bc-ebce-423a-a5a5-7e028dfc9cbf",
      "name": "Select Ideas"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a YouTube content researcher for a fictional beginner-focused channel called \"Beginner AI Lab\".\nThe audience is students and beginners with no technical background.\n\nCreate a research and content plan for this video idea:\n\nTitle: {{ $json['Title'] }}\nTopic: {{ $json['Topic'] }}\nCategory: {{ $json['Category'] }}\nTarget audience: {{ $json['Target Audience'] }}\nIdea summary: {{ $json['Explanation'] }}\n\nProvide:\n- learning_goal: 1 to 2 sentences on what the viewer should learn or be able to do after watching\n- main_points: 4 to 6 key points the video must cover\n- viewer_questions: 4 to 6 questions beginners are likely to ask about this topic\n- intro: a short description of how the video should open and hook the viewer\n- main_content: a short description of the main teaching section, in order\n- examples: 2 to 3 simple, practical examples to show on screen\n- conclusion: a short description of how to wrap up and what to tell viewers to do next\n- verify_before_publishing: facts, features, prices, limits or claims that must be checked before publishing\n\nRules:\n- Use plain, beginner-friendly language.\n- Do not invent statistics, prices, or product features. If something may have changed or you are unsure, list it under verify_before_publishing.\n- Do not use real logos, real channel names or copyrighted content.\n\nReturn only the structured data.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        896,
        0
      ],
      "id": "20172710-c494-4a7f-9f46-7771ce86be00",
      "name": "Generate Research Plan",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.5
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        912,
        240
      ],
      "id": "3a225e79-84e4-4ee0-b7d6-93ba35be848d",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "OqfcnzcL8nOwNYa4",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"learning_goal\": \"Viewers learn how to write clear prompts that give better AI answers.\",\n  \"main_points\": [\"Point one\", \"Point two\", \"Point three\", \"Point four\"],\n  \"viewer_questions\": [\"Question one?\", \"Question two?\", \"Question three?\", \"Question four?\"],\n  \"intro\": \"Open with a relatable problem, then promise a simple fix.\",\n  \"main_content\": \"Walk through the steps in order, with one demo per step.\",\n  \"examples\": [\"Example one\", \"Example two\"],\n  \"conclusion\": \"Recap the key steps and invite viewers to try one prompt today.\",\n  \"verify_before_publishing\": [\"Check any tool features or limits mentioned\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1040,
        240
      ],
      "id": "3ca05428-010e-427a-a7a3-7444c78990e5",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const ideas = $('Select Ideas').all();\nconst today = $now.toFormat('yyyy-MM-dd');\n\nconst bullets = (arr) =>\n  Array.isArray(arr) ? arr.map(x => '• ' + x).join('\\n') : String(arr || '');\n\nreturn $input.all().map((item, i) => {\n  const out = item.json.output;\n  const idea = ideas[i].json;\n  return {\n    json: {\n      'Video ID': idea['Video ID'],\n      'Title': idea['Title'],\n      'Learning Goal': out.learning_goal,\n      'Main Points': bullets(out.main_points),\n      'Viewer Questions': bullets(out.viewer_questions),\n      'Intro': out.intro,\n      'Main Content': out.main_content,\n      'Examples': bullets(out.examples),\n      'Conclusion': out.conclusion,\n      'To Verify': bullets(out.verify_before_publishing),\n      'Status': 'Researched',\n      'Date Created': today\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
