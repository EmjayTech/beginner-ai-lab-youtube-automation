    {
      "parameters": {
        "jsCode": "// Videos that have Publishing Data but no Thumbnails row yet\nconst done = new Set($('Read Existing Thumbnails').all().map(i => i.json['Video ID']).filter(Boolean));\nconst seen = new Set();\nconst out = [];\nfor (const item of $('Read Publishing Data').all()) {\n  const id = item.json['Video ID'];\n  if (!id || !item.json['Recommended Title'] || done.has(id) || seen.has(id)) continue;\n  seen.add(id);\n  out.push({ json: item.json });\n}\nreturn out;"
      },
