      ],
      "id": "2cb40ec2-3e9f-4574-bb44-80d591ec7793",
      "name": "Format Thumbnail Rows"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"concept\": \"A friendly simple robot beside a glowing lightbulb to show AI made easy.\",\n  \"thumbnail_text\": \"AI MADE SIMPLE\",\n  \"visual_description\": \"A flat-style friendly robot made of rounded shapes stands on the right. A large lightbulb glows beside it. The background is a clean blue gradient with empty space on the left for bold text.\",\n  \"image_prompt\": \"Flat vector illustration, friendly small robot made of simple rounded shapes, glowing lightbulb, clean blue and yellow palette, soft gradient background, empty space on the left side for text, 16:9 widescreen, no text, no logos\",\n  \"visual_assets_needed\": [\"Screen recording of a chat tool\", \"Simple diagram of how AI learns\", \"Lightbulb icon\", \"Notebook b-roll\"]\n}"
      },
