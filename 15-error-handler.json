    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turn n8n's error data into one readable record\nconst e = $json.execution || {};\nconst w = $json.workflow || {};\nconst err = e.error || {};\nreturn { json: {\n  'Date': $now.toFormat('yyyy-MM-dd HH:mm:ss'),\n  'Workflow': w.name || 'Unknown workflow',\n  'Failed Node': e.lastNodeExecuted || err.node?.name || 'Unknown node',\n  'Error Message': String(err.message || 'No message').slice(0, 500),\n  'Execution ID': e.id || '',\n  'Execution URL': e.url || '',\n  'Mode': e.mode || '',\n  'Status': 'New'\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
