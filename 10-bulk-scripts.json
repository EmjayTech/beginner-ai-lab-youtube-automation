      "typeVersion": 1.2,
      "position": [
        560,
        240
      ],
      "id": "591e570b-8b25-47fd-a129-b55e59e9b2bf",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "OqfcnzcL8nOwNYa4",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"hook\": \"Ever asked an AI a question and got a useless answer? Stay with me, because in the next five minutes you will fix that.\",\n  \"script\": \"HOOK\\n...\\n\\nSECTION 1: ...\\n...\\n\\nCONCLUSION\\n...\\n\\nCALL TO ACTION\\n...\",\n  \"call_to_action\": \"If this helped, subscribe and watch our next video on writing better prompts.\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        688,
        240
      ],
      "id": "1ea0bbf0-d6a4-4f3e-8732-1ce072349456",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const idea = $('Prepare Script Input').item.json;\nconst out = $json.output;\nconst script = out.script || '';\n\nreturn { json: {\n  'Video ID': idea['Video ID'],\n  'Title': idea['Title'],\n  'Hook': out.hook,\n  'Script': script,\n  'Call To Action': out.call_to_action,\n  'Word Count': script.trim().split(/\\s+/).length,\n  'Status': 'Script Ready',\n  'Date Created': $now.toFormat('yyyy-MM-dd')\n}};"
      },
