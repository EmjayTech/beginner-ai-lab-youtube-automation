    {
      "parameters": {
        "jsCode": "const today = DateTime.now().startOf('day');\nconst KEEP = ['Production', 'Published', 'Failed']; // manual statuses, never overwritten\n\nconst clean = (arr) => arr.map(i => i.json).filter(r => r['Video ID']);\nconst calendar = clean($('Read Content Calendar').all());\nconst scripts  = clean($('Read Scripts').all());\nconst thumbs   = clean($('Read Thumbnails').all());\n\n// Videos that have a non-empty script\nconst hasScript = new Set(\n  scripts.filter(r => String(r['Script'] || '').trim()).map(r => r['Video ID'])\n);\n\n// Latest thumbnail row per video\nconst thumbById = {};\nfor (const r of thumbs) thumbById[r['Video ID']] = r;\n\n// One row per video: calendar rows first, then videos that have a script\n// but are not in the calendar yet\nconst byId = {};\nfor (const r of calendar) byId[r['Video ID']] = r;\nfor (const r of scripts) {\n  if (!byId[r['Video ID']]) {\n    byId[r['Video ID']] = { 'Video ID': r['Video ID'], 'Title': r['Title'] || '' };\n  }\n}\nconst rows = Object.values(byId);\n\n// Fictional publish dates continue after the latest existing date\nconst existing = rows\n  .map(r => DateTime.fromISO(String(r['Publish Date'] || '').trim()))\n  .filter(d => d.isValid);\nlet cursor = existing.length ? DateTime.max(...existing) : today.plus({ days: 4 });\nif (cursor < today) cursor = today;\n\nreturn rows.map(r => {\n  const id = r['Video ID'];\n  const old = String(r['Video Status'] || r['Status'] || '').trim();\n\n  const scriptOk = hasScript.has(id);\n  const t = thumbById[id];\n  const thumbOk = !!(t && String(t['Thumbnail URL'] || '').trim());\n\n  const scriptStatus = scriptOk ? 'Script Ready' : 'Script Required';\n  const thumbStatus = thumbOk ? 'Thumbnail Ready' : (t ? 'Concept Ready' : 'Thumbnail Required');\n\n  let videoStatus, note;\n  if (KEEP.includes(old)) {\n    videoStatus = old;\n    note = r['Notes'] || '';\n  } else if (!scriptOk) {\n    videoStatus = 'Script Required';            // Step 5\n    note = 'No script yet';\n  } else if (!thumbOk) {\n    videoStatus = 'Thumbnail Required';         // Step 6\n    note = 'Script ready, thumbnail missing';\n  } else {\n    videoStatus = 'Ready to Publish';           // Step 7\n    note = 'Script and thumbnail ready';\n  }\n\n  let publishDate = String(r['Publish Date'] || '').trim();\n  if (videoStatus === 'Ready to Publish' && !publishDate) {   // Step 8\n    cursor = cursor.plus({ days: 3 });\n    publishDate = cursor.toFormat('yyyy-MM-dd');\n  }\n\n  return {\n    json: {\n      'Video ID': id,\n      'Title': r['Title'] || r['Video Title'] || '',\n      'Script Status': scriptStatus,\n      'Thumbnail Status': thumbStatus,\n      'Video Status': videoStatus,\n      'Publish Date': publishDate,\n      'Notes': KEEP.includes(old) ? note : `Auto-check ${today.toFormat('yyyy-MM-dd')}: ${note}`\n    }\n  };\n});"
      },
