    {
      "parameters": {
        "jsCode": "// Status BEFORE this run (the calendar was read before it was updated)\nconst before = {};\nfor (const i of $('Read Content Calendar').all()) {\n  const r = i.json;\n  if (r['Video ID']) before[r['Video ID']] = String(r['Video Status'] || r['Status'] || '').trim();\n}\n\n// Keep only videos that are ready now but were not ready before\nreturn $('Check Video Status').all().filter(i =>\n  i.json['Video Status'] === 'Ready to Publish' &&\n  before[i.json['Video ID']] !== 'Ready to Publish'\n);"
      },
