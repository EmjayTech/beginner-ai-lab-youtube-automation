    {
      "parameters": {
        "jsCode": "// Adds every scripted video to the Content Calendar and sets its status.\n// Protected statuses (set manually or by later steps) are never overwritten.\nconst PROTECTED = ['Production', 'Ready to Publish', 'Published', 'Failed'];\nconst hasThumb = new Set($('Read Thumbnails').all().map(i => i.json['Video ID']).filter(Boolean));\nconst calendar = {};\nfor (const i of $('Read Content Calendar').all()) {\n  if (i.json['Video ID']) calendar[i.json['Video ID']] = i.json;\n}\nconst seen = new Set();\nconst out = [];\nlet n = 0;\nfor (const item of $('Read Scripts').all()) {\n  const id = item.json['Video ID'];\n  if (!id || !item.json['Script'] || seen.has(id)) continue;\n  seen.add(id);\n  const existing = calendar[id];\n  if (existing && PROTECTED.includes(existing['Video Status'])) continue;\n  const thumb = hasThumb.has(id);\n  n += 1;\n  out.push({ json: {\n    'Video ID': id,\n    'Title': item.json['Title'],\n    'Script Status': 'Script Ready',\n    'Thumbnail Status': thumb ? 'Concept Ready' : 'Thumbnail Required',\n    'Video Status': thumb ? 'Production' : 'Script Ready',\n    'Publish Date': (existing && existing['Publish Date']) ? existing['Publish Date'] : $now.plus({ days: 2 + n }).toFormat('yyyy-MM-dd'),\n    'Notes': 'Phase 10 bulk add ' + $now.toFormat('yyyy-MM-dd HH:mm') + ': ' + (thumb ? 'script and thumbnail concept ready, moved to production' : 'script ready, thumbnail required') + ' (fictional publish date)'\n  }});\n}\nreturn out;"
      },
