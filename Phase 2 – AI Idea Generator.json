    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a YouTube content strategist for a fictional channel called \"{{ $json.channel_name }}\".\nThe channel teaches {{ $json.channel_topic }} to: {{ $json.audience }}.\n\nGenerate {{ $json.idea_count }} original YouTube video ideas for BEGINNERS.\n\nFor each idea provide:\n- title: a clear, beginner-friendly video title\n- topic: the broad subject (e.g. AI Tools, AI Basics, Productivity, Automation)\n- category: one of Tutorial, Explainer, Comparison, Productivity, Education\n- explanation: 1 to 2 sentences on what the video covers and why it is useful\n- target_audience: who this specific video is for\n- priority: High, Medium or Low\n\nRules:\n- Ideas must be original, practical and realistic. Do not make unsupported claims.\n- Do not use real brand logos, real channel names or copyrighted content.\n- Do NOT repeat any of these existing titles: {{ $json.existing_titles }}\n\nReturn only the structured data.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
