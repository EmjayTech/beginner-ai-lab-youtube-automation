    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"ideas\": [\n    {\n      \"title\": \"5 Free AI Tools Every Student Should Know\",\n      \"topic\": \"AI Tools\",\n      \"category\": \"Tutorial\",\n      \"explanation\": \"Shows five free AI tools students can use for study and notes.\",\n      \"target_audience\": \"Students\",\n      \"priority\": \"High\"\n    }\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1040,
        240
      ],
      "id": "cfe548ab-0e59-4dca-9826-15e855b95f26",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// Find the highest existing Video ID so new ones continue the sequence\nconst existing = $('Read Existing Ideas').all()\n  .map(i => i.json['Video ID'])\n  .filter(Boolean);\n\nlet max = 0;\nfor (const id of existing) {\n  const n = parseInt(String(id).replace('VID-', ''), 10);\n  if (!isNaN(n) && n > max) max = n;\n}\n\nconst ideas = $input.first().json.output.ideas;\nconst today = $now.toFormat('yyyy-MM-dd');\n\nreturn ideas.map((idea, i) => ({\n  json: {\n    'Video ID': `VID-${String(max + i + 1).padStart(3, '0')}`,\n    'Topic': idea.topic,\n    'Title': idea.title,\n    'Category': idea.category,\n    'Target Audience': idea.target_audience,\n    'Status': 'Idea',\n    'Priority': idea.priority,\n    'Date Added': today,\n    'Explanation': idea.explanation\n  }\n}));"
      },
