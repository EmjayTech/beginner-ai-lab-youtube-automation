    {
      "parameters": {
        "jsCode": "const ids = $('Set Selected Videos').first().json.selected_ids\n  .split(',').map(s => s.trim()).filter(Boolean);\n\nconst rows = $('Read Publishing Data').all().map(i => i.json);\n\nconst out = [];\nfor (const id of ids) {\n  // if a video was processed more than once, take the latest row\n  const row = [...rows].reverse().find(r => r['Video ID'] === id);\n  if (!row || !row['Recommended Title']) continue;\n  out.push({ json: row });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -16
      ],
      "id": "c30f6cad-5bde-4ea9-929e-b97759db365e",
      "name": "Select Videos"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a thumbnail designer for a fictional beginner-focused YouTube channel called \"Beginner AI Lab\".\nStyle: clean, friendly, high contrast, easy to read on a phone. Audience: students and beginners.\n\nCreate a thumbnail plan for this video.\n\nTitle: {{ $json['Recommended Title'] }}\nSummary: {{ $json['Summary'] }}\n\nProvide:\n- concept: one sentence describing the thumbnail idea\n- thumbnail_text: 2 to 4 words of large, readable text. It must match the video and not promise anything the video does not cover\n- visual_description: 2 to 4 sentences describing exactly what appears (main subject, background, colours, where the text sits, what is in the foreground)\n- image_prompt: a single detailed prompt for an AI image generator, 16:9 widescreen, that includes the style, subject, background, colour palette and \"empty space on one side for text\". Do not ask the image tool to render text\n- visual_assets_needed: 3 to 5 other visual assets the video will need (for example screen recordings, simple diagrams, icons, b-roll ideas)\n\nRules:\n- No real brand logos, product logos, app icons or named AI products (do not show the logo of any AI tool).\n- No copyrighted characters, celebrities, real people or real channel names.\n- Use generic, original visuals only, such as a friendly robot made of simple shapes, a laptop, a lightbulb, a notebook or abstract shapes.\n- No clickbait, fake numbers or exaggerated claims in the text.\n\nReturn only the structured data.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        896,
        -16
      ],
      "id": "00114a02-7a58-4093-b7f0-e660090e2066",
      "name": "Generate Thumbnail Plan",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        912,
        224
      ],
      "id": "30dfd9a1-310b-4047-bbbc-a910c869c75b",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "OqfcnzcL8nOwNYa4",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"concept\": \"A friendly simple robot beside a glowing lightbulb to show AI made easy.\",\n  \"thumbnail_text\": \"AI MADE SIMPLE\",\n  \"visual_description\": \"A flat-style friendly robot made of rounded shapes stands on the right. A large lightbulb glows beside it. The background is a clean blue gradient with empty space on the left for bold text.\",\n  \"image_prompt\": \"Flat vector illustration, friendly small robot made of simple rounded shapes, glowing lightbulb, clean blue and yellow palette, soft gradient background, empty space on the left side for text, 16:9 widescreen, no text, no logos\",\n  \"visual_assets_needed\": [\"Screen recording of a chat tool\", \"Simple diagram of how AI learns\", \"Lightbulb icon\", \"Notebook b-roll\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1040,
        224
      ],
      "id": "aad44f9c-4715-4001-b744-8fd438c00734",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const videos = $('Select Videos').all();\nconst today = $now.toFormat('yyyy-MM-dd');\n\nconst bullets = (arr) =>\n  Array.isArray(arr) ? arr.map(x => '• ' + x).join('\\n') : String(arr || '');\n\nreturn $input.all().map((item, i) => {\n  const out = item.json.output;\n  const v = videos[i].json;\n  return {\n    json: {\n      'Video ID': v['Video ID'],\n      'Title': v['Recommended Title'],\n      'Concept': out.concept,\n      'Thumbnail Text': String(out.thumbnail_text || '').toUpperCase(),\n      'Visual Description': out.visual_description,\n      'Image Prompt': out.image_prompt,\n      'Visual Assets Needed': bullets(out.visual_assets_needed),\n      'Thumbnail Status': 'Concept Ready',\n      'Date Created': today\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
