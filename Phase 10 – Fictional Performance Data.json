      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mark the video as Published in the calendar (simulated publish)\nconst p = $('Pick Videos To Publish').all().map(i => i.json).find(x => x['Video ID'] === $json['Video ID']) || {};\nconst wasPublished = p['Old Status'] === 'Published';\nreturn { json: {\n  'Video ID': $json['Video ID'],\n  'Video Status': 'Published',\n  'Publish Date': (wasPublished && p['Old Publish Date']) ? p['Old Publish Date'] : $now.toFormat('yyyy-MM-dd'),\n  'Notes': wasPublished && p['Old Notes'] ? p['Old Notes'] : 'Simulated publish (fictional). Test data only.'\n}};"
