    {
      "parameters": {
        "jsCode": "// Videos that are Ready to Publish (or already Published) but have no performance data yet\nconst done = new Set($('Read Video Performance').all().map(i => i.json['Video ID']).filter(Boolean));\nconst seen = new Set();\nconst out = [];\nfor (const item of $('Read Content Calendar').all()) {\n  const r = item.json;\n  const id = r['Video ID'];\n  const st = String(r['Video Status'] || '').trim();\n  if (!id || seen.has(id) || done.has(id)) continue;\n  if (st !== 'Ready to Publish' && st !== 'Published') continue;\n  seen.add(id);\n  out.push({ json: { 'Video ID': id, 'Title': r['Title'], 'Old Status': st, 'Old Publish Date': r['Publish Date'] || '', 'Old Notes': r['Notes'] || '' } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        272
      ],
      "id": "010227c8-5e66-4120-876b-2506c91cd474",
      "name": "Pick Videos To Publish"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// FICTIONAL data for testing only\nconst rnd = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\nconst views = rnd(3000, 20000);\nreturn { json: {\n  'Video ID': $json['Video ID'],\n  'Views': views,\n  'Likes': Math.round(views * rnd(40, 110) / 1000),\n  'Comments': Math.round(views * rnd(5, 25) / 1000),\n  'Watch Time': Math.round(views * (rnd(20, 45) / 10) / 60),\n  'CTR': rnd(30, 85) / 10,\n  'Date': $now.minus({ days: rnd(1, 14) }).toFormat('yyyy-MM-dd'),\n  'Subscribers Gained': Math.round(views * rnd(5, 20) / 1000)\n}};"
      },
